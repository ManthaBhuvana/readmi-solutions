# Copy this file to .env for local development (never commit .env).
# On Vercel: Project -> Settings -> Environment Variables.

# The "Web app" URL from Google Apps Script (ends in /exec)
WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Must be identical to SECRET inside backend/google-apps-script.gs
WEBHOOK_SECRET=replace-with-a-long-random-string
